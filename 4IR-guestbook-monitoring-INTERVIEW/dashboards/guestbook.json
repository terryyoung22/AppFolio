      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(apache_duration_ms_total{namespace=\"guestbook\"}[2m])) / clamp_min(sum(rate(apache_accesses_total{namespace=\"guestbook\"}[2m])), 0.001)",
          "legendFormat": "avg"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
